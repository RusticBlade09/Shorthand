{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shorthand",
  "version": "0.1.1",
  "identifier": "com.shorthand.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shorthand",
        "width": 760,
        "height": 540,
        "minWidth": 560,
        "minHeight": 400,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      },
      {
        "label": "popup",
        "url": "popup.html",
        "title": "Shorthand",
        "width": 440,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
